package build.`scaladoc-testcases`

import scala3build.*

import mill.*

trait ScaladocTestcases extends CrossScala3Module with mill.scala3buildhelper.CompileClassesPathHelper {
  def moduleDeps = Seq(
    build.compiler()
  )
  def mainSources = Task.Source("src")
  def sources = Task {
    val baseSources = super.sources()
    assert(baseSources.exists(_.path == mainSources().path))
    baseSources
  }
}

object `package` extends Cross[ScaladocTestcases](Mode.allValues)
