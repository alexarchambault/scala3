package build.`sbt-bridge`

import scala3build.*

import mill.*
import mill.scalalib.*

trait SbtBridge extends CrossScala3Module { outer =>
  def artifactId = artifactName()
  def moduleDeps = Seq(build.compiler()) ++
    (if (mode == Mode.Bootstrapping) Nil else Seq(build.repl()))
  def mvnDeps = Seq(
    mvn"org.scala-sbt:compiler-interface:1.10.7"
  )

  object test extends Scala3Tests {
    def mvnDeps = Seq(
      mvn"org.scala-sbt:zinc-apiinfo_2.13:1.8.0"
        .exclude(("org.scala-lang", "*"))
    )
  }
}

object `package` extends Cross[SbtBridge](Mode.allValues)
