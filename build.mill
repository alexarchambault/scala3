def enableBspForFinalModules = false

trait Scala3JavaModule extends JavaModule with PublishModule with Mima {
  trait Scala3JavaTests extends JavaTests with TestModule with TestModule.Junit5 {
    def testSources: T[Seq[PathRef]]
    def sources = testSources
    def testParallelism = false

    def useMunit: Boolean = false

    def testFramework =
      if (useMunit) "munit.Framework"
      else "com.github.sbt.junit.jupiter.api.JupiterFramework"
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.github.sbt.junit:jupiter-interface:0.13.3",
      mvn"org.junit.platform:junit-platform-launcher:1.14.1",
      mvn"org.junit.jupiter:junit-jupiter-api:${Versions.junitJupiter}",
      mvn"org.scalameta::munit:1.2.1"
        .exclude(("org.scala-lang", "scala-library"))
        .exclude(("org.scala-lang", "scala3-library_3"))
    )

    def discoveredTestClasses =
      if (useMunit) super[TestModule].discoveredTestClasses
      else super[Junit5].discoveredTestClasses
  }

  def jvmId = "17" // force external zinc worker

  def pomSettings = PomSettings(
    description = "sumlib",
    organization = "org.scala-lang",
    url = "https://github.com/scala/scala3",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("scala", "scala3"),
    developers = Seq(Developer("scala", "The Scala Team", "https://scala-lang.org", email = "security@scala-lang.org"))
  )
  def publishVersion = Versions.dottyVersion

  def javacOptions = super.javacOptions() ++ Seq(
    "--release", Versions.minimumJVMVersion
  )

  def manifest = super.manifest().add(
    "Automatic-Module-Name" ->
      s"${pomSettings().organization.replaceAll("-", ".")}.${artifactName().replaceAll("-", ".")}"
  )

  def runClasspathAsJars: T[Seq[PathRef]] = Task {
    resolvedRunMvnDeps().toSeq ++
      transitiveJars() ++
      Seq(jar())
  }
}

trait Scala3Module extends Scala3JavaModule with ScalaModule { outer =>
  def kindLevel: KindLevel = KindLevel(Kind.Pure, Level.Final)

  def scalaVersion =
    if (kindLevel.isBootstrapping) Versions.referenceVersion
    else Versions.dottyVersion

  def scalaLibraryMvnDeps = Nil
  def scalaCompilerClasspath =
    if (kindLevel.isBootstrapping)
      Task {
        defaultResolver().classpath(
          Seq(mvn"org.scala-lang:scala3-compiler_3:${Versions.referenceVersion}")
        )
      }
    else
      if (kindLevel.isHybrid) compiler(KindLevel(Kind.Hybrid, Level.Bootstrapping)).runClasspathAsJars
      else compiler(KindLevel(Kind.Pure, Level.Bootstrapping)).runClasspathAsJars

  def scalaCompilerBridge =
    if (kindLevel.isBootstrapping)
      Task(None)
    else
      if (kindLevel.isHybrid)
        Task {
          Some(`sbt-bridge`(KindLevel(Kind.Hybrid, Level.Bootstrapping)).jar())
        }
      else
        Task {
          Some(`sbt-bridge`(KindLevel(Kind.Pure, Level.Bootstrapping)).jar())
        }

  def scalacOptions = super.scalacOptions() ++ Seq(
    "-feature",
    "-deprecation",
    "-unchecked",
    //"-Wconf:cat=deprecation&msg=Unsafe:s",    // example usage
    //"-Wunused:all",
    //"-rewrite", // requires -Werror:false since no rewrites are applied with errors
    "-encoding", "UTF8",
    "-language:implicitConversions",
    "--java-output-version", Versions.minimumJVMVersion
  )

  trait Scala3Tests extends ScalaTests with Scala3JavaTests {
    def scalaLibraryMvnDeps = outer.scalaLibraryMvnDeps
    def scalaCompilerClasspath = outer.scalaCompilerClasspath
  }

  def scalaInternalKeepScala2Library = kindLevel.isHybrid && !kindLevel.isBootstrapping
  def enableBsp = kindLevel.isBootstrapping || enableBspForFinalModules
}

trait CrossScala3Module extends Cross.Module[KindLevel] with Scala3Module {
  def kindLevel = crossValue
}

object interfaces extends Scala3JavaModule

trait SbtBridge extends CrossScala3Module {
  def moduleDeps = super.moduleDeps ++ Seq(
    compiler(crossValue)
  )
  def sources = Task.Sources("src")
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"org.scala-sbt:compiler-interface:1.10.7"
  )
}

object `sbt-bridge` extends Cross[SbtBridge](KindLevel.allValues)

trait Library extends CrossScala3Module with mill.scala3build.CompileClassesPathHelper {
  def scalacOptions = Task {
    val sharedOptions = Seq(
      "-sourcepath", sources().map(_.path).distinct.mkString(File.pathSeparator),
      "-Yexplicit-nulls"
    )
    if (kindLevel.isHybrid)
      super.scalacOptions() ++ Seq("-Werror") ++ sharedOptions
    else
      // Original comment: TODO: Enable fatal warnings after 3.8 because old stdlib has different nullability.
      super.scalacOptions() ++
        sharedOptions ++
        Seq("-Yno-stdlib-patches")
  }

  def mvnDeps = super.mvnDeps() ++ {
    if (kindLevel.isHybrid)
      Seq(mvn"org.scala-lang:scala-library:${Versions.stdlibNonBootstrappedVersion}")
    else
      Nil
  }

  def baseSource = Task.Source("src")
  def sources =
    if (kindLevel.isHybrid)
      Task {
        val src0 = baseSource().path
        os.walk(src0)
          .filter(os.isFile)
          .filter { f =>
            f.last.endsWith(".scala") || {
              f.last.endsWith(".java") && {
                val subPath = f.subRelativeTo(src0)
                subPath.startsWith(os.sub / "scala/annotation/internal") ||
                subPath.startsWith(os.sub / "scala/runtime/function")
              }
            }
          }
          .filter(f => os.read.lines(f).forall(_.trim != "import scala.language.`2.13`"))
          .map(PathRef(_))
      }
    else
      Task(Seq(baseSource()))

  def jar = Task {
    val jar0 = super.jar()
    val dest = Task.dest / s"scala-library-${Versions.dottyVersion}.jar"
    os.copy(jar0.path, dest)
    PathRef(dest)
  }

  def runClasspath =
    if (kindLevel.isHybrid)
      if (kindLevel.isBootstrapping)
        Task {
          super.runClasspath().filter { ref =>
            ref.path.startsWith(BuildCtx.workspaceRoot) ||
              !ref.path.last.startsWith("scala3-library_3")
          }
        }
      else
        Task {
          super.runClasspath().filter(ref => !ref.path.startsWith(BuildCtx.workspaceRoot)) ++
            Seq(jar())
        }
    else
      Task {
        Seq(jar())
      }

  def precomputedRunClasspath: T[Seq[String]] =
    if (kindLevel.isHybrid)
      Task {
        resolvedRunMvnDeps().map(_.path.toString) ++
          Seq(compileClassesPath0.toString)
      }
    else
      Task {
        Seq(compileClassesPath0.toString)
      }

  /*
    TODO Add library-aux in source JAR?

    (Compile / packageSrc / mappings) ++= {
      val auxBase = (ThisBuild / baseDirectory).value / "library-aux/src"
      auxBase ** "*.scala" pair io.Path.relativeTo(auxBase)
    }

  */
}

