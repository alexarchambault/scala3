object scaladoc extends Module {
  def src = Task.Source("src")
  def testSrc = Task.Source("test")

  def `test-documentations` = Task.Source("test-documentations")

  private def flexmarkVersion = "0.62.2"
  private def jacksonVersion = "2.15.1"

  def buildInfoSources = Task {
    val dir = Task.dest
    os.write(
      dir / "dotty/tools/scaladoc/BuildInfo.scala",
      s"""package dotty.tools.scaladoc
         |
         |object BuildInfo {
         |  def version = "${Versions.dottyVersion}"
         |}
         |""".stripMargin,
      createFolders = true
    )
    PathRef(dir)
  }

  trait Scaladoc extends Scala3Module { scaladoc =>
    def sources = Task {
      Seq(src(), buildInfoSources())
    }
    def testSources = Task {
      Seq(testSrc(), buildInfoTestSources())
    }
    def scalacOptions = super.scalacOptions() ++ Seq(
      "-experimental"
    )
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.vladsch.flexmark:flexmark:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-util-ast:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-util-data:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-util-html:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-anchorlink:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-autolink:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-emoji:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-gfm-strikethrough:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-gfm-tasklist:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-wikilink:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-tables:$flexmarkVersion",
      mvn"com.vladsch.flexmark:flexmark-ext-yaml-front-matter:$flexmarkVersion",
      mvn"nl.big-o:liqp:0.8.2",
      mvn"org.jsoup:jsoup:1.17.2", // Original comment: Needed to process .html files for static site
      mvn"com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:$jacksonVersion"
    )
    def mainClass = Some("dotty.tools.scaladoc.Main")

    def scaladocTestcasesCompile: T[mill.javalib.api.CompilationResult]
    def scaladocTestcasesCompileClassesPath: os.Path
    def buildInfoTestSources = Task {
      val dir = Task.dest
      val tq = "\"\"\""
      os.write(
        dir / "dotty/tools/scaladoc/test/BuildInfo.scala",
        s"""package dotty.tools.scaladoc.test
           |
           |object BuildInfo {
           |  def test_testcasesOutputDir: Seq[String] = Seq($tq$scaladocTestcasesCompileClassesPath$tq)
           |  def test_testcasesSourceRoot: String = $tq${`scaladoc-testcases`.src().path}$tq
           |  def testDocumentationRoot: String = $tq${`test-documentations`().path}$tq
           |}
           |""".stripMargin,
        createFolders = true
      )
      PathRef(dir)
    }

    trait ScaladocTests extends Scala3Tests with Scala3Module {
      def testSources = scaladoc.testSources
      def runClasspath = Task {
        // Ensure scaladoc-testcases is compiled, so that the directory
        // we refer to via scaladocTestcasesCompileClassesPath exists
        val fromCompile = scaladocTestcasesCompile().classes.path
        val beforeCompile = scaladocTestcasesCompileClassesPath
        if (fromCompile != beforeCompile)
          System.err.println(
            "Warning: scaladoc-testcases compilation output dir calculation mismatch: " +
            s"pre-computed value $beforeCompile differs from actual value $fromCompile."
          )
        super.runClasspath()
      }
    }
  }

  object hybrid extends Module {
    object bootstrapping extends Scaladoc with Bootstrapping {
      def moduleDeps = super.moduleDeps ++ Seq(
        compiler.hybrid.bootstrapping,
        `tasty-inspector`.hybrid.bootstrapping
      )
      def scaladocTestcasesCompile = `scaladoc-testcases`.hybrid.bootstrapping.compile
      def scaladocTestcasesCompileClassesPath = `scaladoc-testcases`.hybrid.bootstrapping.compileClassesPath0
      object test extends ScaladocTests with Bootstrapping {
        def moduleDeps = super.moduleDeps ++ Seq(
          `test-helpers`.hybrid.bootstrapping
        )
      }
    }
    object `final` extends Scaladoc with Hybrid {
      def moduleDeps = super.moduleDeps ++ Seq(
        compiler.hybrid.`final`,
        `tasty-inspector`.hybrid.`final`
      )
      def scaladocTestcasesCompile = `scaladoc-testcases`.hybrid.`final`.compile
      def scaladocTestcasesCompileClassesPath = `scaladoc-testcases`.hybrid.`final`.compileClassesPath0
      object test extends ScaladocTests with Hybrid {
        def moduleDeps = super.moduleDeps ++ Seq(
          `test-helpers`.hybrid.`final`
        )
      }
    }
  }
  object pure extends Module {
    object bootstrapping extends Scaladoc with Bootstrapping {
      def moduleDeps = super.moduleDeps ++ Seq(
        compiler.pure.bootstrapping,
        `tasty-inspector`.pure.bootstrapping
      )
      def scaladocTestcasesCompile = `scaladoc-testcases`.pure.bootstrapping.compile
      def scaladocTestcasesCompileClassesPath = `scaladoc-testcases`.pure.bootstrapping.compileClassesPath0
      object test extends ScaladocTests with Bootstrapping {
        def moduleDeps = super.moduleDeps ++ Seq(
          `test-helpers`.pure.bootstrapping
        )
      }
    }
    object `final` extends Scaladoc with Pure {
      def moduleDeps = super.moduleDeps ++ Seq(
        compiler.pure.`final`,
        `tasty-inspector`.pure.`final`
      )
      def scaladocTestcasesCompile = `scaladoc-testcases`.pure.`final`.compile
      def scaladocTestcasesCompileClassesPath = `scaladoc-testcases`.pure.`final`.compileClassesPath0
      object test extends ScaladocTests with Pure {
        def moduleDeps = super.moduleDeps ++ Seq(
          `test-helpers`.pure.`final`
        )
      }
    }
  }
}

object `presentation-compiler` extends CoursierModule {

  def mtagsVersion = "1.6.2"

  def src = Task.Source("src")
  def testSrc = Task.Source("test")

  def mtagsSharedSources = Task {
    val srcPath = defaultResolver().classpath(
      Seq(mvn"org.scalameta:mtags-shared_2.13.16:$mtagsVersion".dep.withTransitive(false)),
      sources = true
    )
    assert(srcPath.length == 1, "Expected a single source JAR")
    val srcJar = srcPath.head.path
    os.unzip(srcJar, Task.dest)

    for (f <- os.walk(Task.dest) if os.isFile(f) && f.last.endsWith(".scala")) {
      val lines = os.read.lines(f).toList
      val updatedLines = Shading.insertUnsafeNullsImport(Shading.replaceProtobuf(lines))
      os.write.over(f, updatedLines.mkString(System.lineSeparator()))
    }

    PathRef(Task.dest)
  }

  trait PresentationCompiler extends Scala3Module {

    def libraryPrecomputedRunClasspath: T[Seq[String]] = Task(Nil)
    def libraryRunClasspath: T[Seq[PathRef]]

    def buildInfoSources = Task {
      val dir = Task.dest
      os.write(
        dir / "dotty/tools/pc/buildinfo/BuildInfo.scala",
        s"""package dotty.tools.pc.buildinfo
           |
           |object BuildInfo {
           |  def scalaVersion = "${scalaVersion()}"
           |}
           |""".stripMargin,
        createFolders = true
      )
      PathRef(dir)
    }

    def sources = Task {
      Seq(`presentation-compiler`.src(), mtagsSharedSources(), buildInfoSources())
    }

    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.lz4:lz4-java:1.8.0",
      mvn"io.get-coursier:interface:1.0.18",
      mvn"org.scalameta:mtags-interfaces:$mtagsVersion",
      mvn"com.google.guava:guava:33.2.1-jre"
    )
    def scalacOptions = super.scalacOptions() ++ Seq(
      "-source", "3.3", // Original comment: To avoid fatal migration warnings
      "-Yexplicit-nulls", "-Wsafe-init",
      "-experimental" // not needed in sbt, not sure why we need it here
    )

    trait PresentationCompilerTests extends Scala3Tests {
      def testSources = Task {
        Seq(`presentation-compiler`.testSrc(), testBuildInfoSources())
      }

      def testBuildInfoSources = Task {
        val dir = Task.dest
        val tq = "\"\"\""
        // TODO Add scala3-presentation-compiler-testcases cp too
        val testDepCp = libraryPrecomputedRunClasspath()
        os.write(
          dir / "dotty/tools/pc/tests/buildinfo/BuildInfo.scala",
          s"""package dotty.tools.pc.tests.buildinfo
             |
             |import java.io.File
             |
             |object BuildInfo {
             |  def scalaVersion = "${scalaVersion()}"
             |  def ideTestsDependencyClasspath = ${testDepCp.map(p => s"new File($tq$p$tq)").mkString("Seq[File](", ", ", ")")}
             |}
             |""".stripMargin,
          createFolders = true
        )
        PathRef(dir)
      }

      def mvnDeps = super.mvnDeps() ++ Seq(
        mvn"org.hamcrest:hamcrest-core:1.3"
      )

      def runClasspath = Task {
        val precomputed = libraryPrecomputedRunClasspath().map(os.Path(_)).filter(os.exists)
        val actual = libraryRunClasspath().map(_.path).filter(os.exists)
        if (precomputed != actual)
          System.err.println(
            "Warning: standard library class path calculation mismatch: " +
            s"pre-computed value $precomputed differs from actual value $actual."
          )
        super.runClasspath()
      }
    }
  }

  object hybrid extends Module {
    object bootstrapping extends PresentationCompiler with Bootstrapping {
      def moduleDeps = Seq(
        compiler.hybrid.bootstrapping
      )
      def libraryPrecomputedRunClasspath = library.hybrid.bootstrapping.precomputedRunClasspath
      def libraryRunClasspath = library.hybrid.bootstrapping.runClasspath().filter(ref => os.exists(ref.path))
      object test extends PresentationCompilerTests
    }
    object `final` extends PresentationCompiler with Hybrid {
      def moduleDeps = Seq(
        compiler.hybrid.`final`
      )
      def libraryPrecomputedRunClasspath = library.hybrid.`final`.precomputedRunClasspath
      def libraryRunClasspath = library.hybrid.`final`.runClasspath().filter(ref => os.exists(ref.path))
      object test extends PresentationCompilerTests
    }
  }
  object pure extends Module {
    object bootstrapping extends PresentationCompiler with Bootstrapping {
      def moduleDeps = Seq(
        compiler.pure.bootstrapping
      )
      def libraryPrecomputedRunClasspath = library.pure.bootstrapping.precomputedRunClasspath
      def libraryRunClasspath = library.pure.bootstrapping.runClasspath().filter(ref => os.exists(ref.path))
      object test extends PresentationCompilerTests
    }
    object `final` extends PresentationCompiler with Pure {
      def moduleDeps = Seq(
        compiler.pure.`final`
      )
      def libraryPrecomputedRunClasspath = library.pure.`final`.precomputedRunClasspath
      def libraryRunClasspath = library.pure.`final`.runClasspath().filter(ref => os.exists(ref.path))
      object test extends PresentationCompilerTests
    }
  }
}

object ci extends Module {
  def noEmptySources(tasks: mill.util.Tasks[Seq[PathRef]]) = Task.Command[Unit] {
    val values = tasks.value.zip(Task.sequence(tasks.value)())
    val invalid = values.filter(_._2.isEmpty)

    if (invalid.nonEmpty) {
      System.err.println("Found modules with no sources:")
      for ((m, _) <- invalid)
        System.err.println(s"  $m")
      sys.error(s"Found modules with no sources: ${invalid.map(_._1).mkString(", ")}")
    }
  }
}
