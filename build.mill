  def scalacOptions = super.scalacOptions() ++ {
    val sharedOptions = Seq("-source:3.0-migration")
    val extraOptions = if (kindLevel.isHybrid) Nil else Seq("-Yno-stdlib-patches")
    sharedOptions ++ extraOptions
